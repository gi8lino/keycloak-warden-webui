# syntax=docker/dockerfile:1.29

# GoReleaser supplies one prebuilt binary per TARGETPLATFORM; do not rebuild.
FROM --platform=$BUILDPLATFORM alpine:3.24 AS prep

RUN install -d -o 0 -g 0 -m 2775 /outfs/config /outfs/data /outfs/tmp

FROM gcr.io/distroless/static:nonroot

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/warden-webui /warden-webui
# Copy the directory entries themselves so their group-writable modes survive.
COPY --from=prep /outfs/ /

ENV HOME=/tmp \
  WARDEN_WEBUI__LISTEN_ADDRESS=:8082 \
  WARDEN_WEBUI__MANAGEMENT_LISTEN_ADDRESS=:8083 \
  WARDEN_WEBUI__DATABASE=/data/warden-webui.db

WORKDIR /data
USER 65532:0

ENTRYPOINT ["/warden-webui"]
