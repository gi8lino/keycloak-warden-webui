# Nonsecret WebUI configuration shared by both deployment variants.
# Change the public URL to the browser-facing HTTPS URL, including any route prefix.
WARDEN_WEBUI__LISTEN_ADDRESS=:8082
WARDEN_WEBUI__MANAGEMENT_LISTEN_ADDRESS=:8083
WARDEN_WEBUI__PUBLIC_URL=https://warden-ui.example.com
WARDEN_WEBUI__DATABASE=/data/warden-webui.db
WARDEN_WEBUI__AUTH_MODE=local
